generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("owner")
  name         String   @default("")
  phone        String   @default("")
  salonId      String?  @unique
  salon        Salon?   @relation(fields: [salonId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
}

model Salon {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  category         String
  quettaArea       String
  address          String
  phone            String
  whatsappNumber   String
  openTime         String
  closeTime        String
  breakStart       String        @default("")
  breakEnd         String        @default("")
  workingDaysJson  String        @default("[0,1,2,3,4,5,6]")
  imageUrl         String
  galleryJson      String        @default("[]")
  mapsUrl          String
  rating           Float         @default(0)
  reviewCount      Int           @default(0)
  viewCount        Int           @default(0)
  featured         Boolean       @default(false)
  approvalStatus   String        @default("PENDING")
  rejectionReason  String        @default("")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  owner            User?
  services         Service[]
  staff            Staff[]
  appointments     Appointment[]
  reviews          Review[]
}

model Service {
  id              String               @id @default(cuid())
  salonId         String
  name            String
  durationMinutes Int
  pricePkr        Int
  category        String
  salon           Salon                @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointments    AppointmentService[]

  @@index([salonId])
}

model Staff {
  id        String @id @default(cuid())
  salonId   String
  name      String
  specialty String
  photoUrl  String @default("")
  salon     Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId])
}

model Appointment {
  id                 String               @id @default(cuid())
  salonId            String
  customerName       String
  customerPhone      String
  appointmentDate    String
  appointmentTime    String
  durationMinutes    Int
  totalPricePkr      Int
  advanceAmountPkr   Int                  @default(0)
  paidAmountPkr      Int                  @default(0)
  remainingAmountPkr Int                  @default(0)
  paymentStatus      String               @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  paymentProvider    String?              // JAZZCASH, EASYPAISA
  paymentRef         String?              // Provider transaction reference
  status             String               @default("PENDING") // PENDING, CONFIRMED, COMPLETED, CANCELLED
  specialNotes       String               @default("")
  staffName          String               @default("Any Available")
  expiresAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now()) @updatedAt
  salon              Salon                @relation(fields: [salonId], references: [id], onDelete: Cascade)
  services           AppointmentService[]
  review             Review?
  payments           Payment[]

  @@index([salonId])
  @@index([appointmentDate])
  @@index([customerPhone])
  @@index([paymentStatus])
}

model Payment {
  id                  String      @id @default(cuid())
  appointmentId       String
  appointment         Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  salonId             String
  customerName        String
  customerPhone       String
  provider            String      // JAZZCASH, EASYPAISA
  internalRef         String      @unique
  providerRef         String?
  totalBookingPkr     Int
  advanceRequiredPkr  Int
  amountPaidPkr       Int         @default(0)
  remainingBalancePkr Int         @default(0)
  amountPaisa         Int
  status              String      @default("PENDING") // PENDING, PAID, FAILED, CANCELLED
  paymentMethod       String?
  rawRequestJson      String?     @default("{}")
  rawResponseJson     String?     @default("{}")
  failureReason       String?
  paidAt              DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @default(now()) @updatedAt

  @@index([appointmentId])
  @@index([internalRef])
  @@index([providerRef])
  @@index([status])
}

model AppointmentService {
  appointmentId String
  serviceId     String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([appointmentId, serviceId])
}

model Review {
  id               String       @id @default(cuid())
  salonId          String
  appointmentId    String?      @unique
  customerName     String
  customerPhone    String
  rating           Int
  comment          String       @default("")
  likedTagsJson    String       @default("[]")
  dislikedTagsJson String       @default("[]")
  platformFeedback String       @default("")
  createdAt        DateTime     @default(now())
  salon            Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointment      Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([salonId])
}
