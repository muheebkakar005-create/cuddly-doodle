generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String               @id @default(cuid())
  email           String               @unique
  passwordHash    String
  role            String               @default("owner")
  name            String               @default("")
  phone           String               @default("")
  salonId         String?              @unique
  salon           Salon?               @relation(fields: [salonId], references: [id], onDelete: SetNull)
  paymentAccounts SalonPaymentAccount[]
  staffProfile    Staff?
  createdAt       DateTime             @default(now())
}

model Salon {
  id               String               @id @default(cuid())
  name             String
  slug             String               @unique
  category         String
  quettaArea       String
  address          String
  phone            String
  whatsappNumber   String
  openTime         String
  closeTime        String
  breakStart       String               @default("")
  breakEnd         String               @default("")
  workingDaysJson  String               @default("[0,1,2,3,4,5,6]")
  imageUrl         String
  galleryJson      String               @default("[]")
  mapsUrl          String
  rating           Float                @default(0)
  reviewCount      Int                  @default(0)
  viewCount        Int                  @default(0)
  featured         Boolean              @default(false)
  approvalStatus   String               @default("PENDING")
  rejectionReason  String               @default("")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  owner            User?
  paymentAccount   SalonPaymentAccount?
  payouts          Payout[]
  payments         Payment[]
  commissions      PlatformCommission[]
  services         Service[]
  staff            Staff[]
  appointments     Appointment[]
  reviews          Review[]
}

model SalonPaymentAccount {
  id                 String                   @id @default(cuid())
  salonId            String                   @unique
  ownerId            String?
  provider           String                   // JAZZCASH, EASYPAISA, BANK
  accountHolderName  String
  accountNumber      String                   // Mobile wallet number or IBAN / Account Number
  bankName           String?                  // e.g. Habib Bank Limited, Meezan Bank
  branchCode         String?
  cnic               String?                  // Owner CNIC for KYC verification
  businessTitle      String?
  verificationStatus String                   @default("PENDING") // PENDING, VERIFIED, REJECTED, SUSPENDED
  rejectionReason    String?
  verifiedAt         DateTime?
  verifiedBy         String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  salon              Salon                    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  owner              User?                    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  auditLogs          PaymentAccountAuditLog[]

  @@index([salonId])
  @@index([ownerId])
  @@index([verificationStatus])
}

model Payout {
  id                String    @id @default(cuid())
  salonId           String
  amountPkr         Int
  amountPaisa       Int
  provider          String    // JAZZCASH, EASYPAISA, BANK
  accountHolderName String
  accountNumber     String
  bankName          String?
  payoutRef         String    @unique // Unique disbursement reference e.g. PO-20261025-XXXX
  status            String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, REJECTED
  notes             String?
  processedBy       String?   // Super admin who approved/executed settlement
  createdAt         DateTime  @default(now())
  completedAt       DateTime?
  salon             Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  payments          Payment[]

  @@index([salonId])
  @@index([status])
  @@index([payoutRef])
}

model PaymentAccountAuditLog {
  id                    String              @id @default(cuid())
  salonPaymentAccountId String
  action                String              // CREATED, UPDATED, VERIFIED, REJECTED, SUSPENDED
  changedBy             String              // User email or ID
  oldValuesJson         String?             @default("{}")
  newValuesJson         String              @default("{}")
  ipAddress             String?
  createdAt             DateTime            @default(now())
  paymentAccount        SalonPaymentAccount @relation(fields: [salonPaymentAccountId], references: [id], onDelete: Cascade)

  @@index([salonPaymentAccountId])
  @@index([createdAt])
}

model Service {
  id              String               @id @default(cuid())
  salonId         String
  name            String
  durationMinutes Int
  pricePkr        Int
  category        String
  salon           Salon                @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointments    AppointmentService[]

  @@index([salonId])
}

model Staff {
  id                 String  @id @default(cuid())
  salonId            String
  name               String
  specialty          String
  photoUrl           String  @default("")
  loginEmail         String? @unique
  passwordHash       String  @default("")
  canManageBookings  Boolean @default(true)
  canManageServices  Boolean @default(false)
  canManagePayments  Boolean @default(false)
  salon              Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  userId             String? @unique
  user               User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([salonId])
}

model Appointment {
  id                 String               @id @default(cuid())
  salonId            String
  customerName       String
  customerPhone      String
  appointmentDate    String
  appointmentTime    String
  durationMinutes    Int
  totalPricePkr      Int
  advanceAmountPkr   Int                  @default(0)
  paidAmountPkr      Int                  @default(0)
  remainingAmountPkr Int                  @default(0)
  paymentStatus      String               @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  paymentProvider    String?              // JAZZCASH, EASYPAISA
  paymentRef         String?              // Provider transaction reference
  status             String               @default("PENDING") // PENDING, CONFIRMED, COMPLETED, CANCELLED
  specialNotes       String               @default("")
  staffName          String               @default("Any Available")
  accessToken        String?              @unique @default(cuid())
  reminderSentAt     DateTime?
  expiresAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now()) @updatedAt
  salon              Salon                @relation(fields: [salonId], references: [id], onDelete: Cascade)
  services           AppointmentService[]
  review             Review?
  payments           Payment[]

  @@index([salonId])
  @@index([appointmentDate])
  @@index([customerPhone])
  @@index([paymentStatus])
}

model Payment {
  id                  String              @id @default(cuid())
  appointmentId       String
  appointment         Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  salonId             String
  salon               Salon               @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customerName        String
  customerPhone       String
  provider            String              // JAZZCASH, EASYPAISA
  internalRef         String              @unique
  providerRef         String?
  paymentType         String              @default("ADVANCE") // ADVANCE, REMAINING, FULL
  totalBookingPkr     Int
  advanceRequiredPkr  Int
  amountPaidPkr       Int                 @default(0)
  remainingBalancePkr Int                 @default(0)
  amountPaisa         Int
  // 10% Platform Commission breakdown (1,000 bps)
  commissionRateBps   Int                 @default(1000)
  commissionPkr       Int                 @default(0)
  commissionPaisa     Int                 @default(0)
  salonSharePkr       Int                 @default(0)
  salonSharePaisa     Int                 @default(0)
  status              String              @default("PENDING") // PENDING, PAID, FAILED, CANCELLED
  settlementStatus    String              @default("PENDING_SETTLEMENT") // PENDING_SETTLEMENT, PROCESSING, SETTLED, CANCELLED
  settledAt           DateTime?
  payoutId            String?
  payout              Payout?             @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  commission          PlatformCommission?
  paymentMethod       String?
  rawRequestJson      String?             @default("{}")
  rawResponseJson     String?             @default("{}")
  failureReason       String?
  handshakeReceivedAt DateTime?
  paidAt              DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @default(now()) @updatedAt

  @@index([appointmentId])
  @@index([salonId])
  @@index([internalRef])
  @@index([providerRef])
  @@index([status])
  @@index([settlementStatus])
  @@index([paymentType])
}

model PlatformCommission {
  id                   String      @id @default(cuid())
  paymentId            String      @unique
  payment              Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  appointmentId        String
  salonId              String
  salon                Salon       @relation(fields: [salonId], references: [id], onDelete: Cascade)
  paymentType          String      @default("ADVANCE") // ADVANCE, REMAINING, FULL
  advanceAmountPaisa   Int
  advanceAmountPkr     Int
  rateBps              Int         @default(1000) // 10% = 1000 basis points
  commissionPaisa      Int
  commissionPkr        Int
  salonAllocationPaisa Int
  salonAllocationPkr   Int
  providerRef          String?
  provider             String      // JAZZCASH, EASYPAISA
  status               String      @default("EARNED") // EARNED, REVERSED, REFUNDED
  settlementStatus     String      @default("RETAINED") // RETAINED, SETTLED, ADJUSTED
  settledAt            DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([salonId])
  @@index([status])
  @@index([settlementStatus])
  @@index([paymentType])
  @@index([createdAt])
}

model PlatformPaymentConfig {
  id                     String   @id @default("platform-config")
  accountHolderName      String   @default("QSalon Platform Collection")
  provider               String   @default("JAZZCASH") // JAZZCASH, EASYPAISA, BANK
  accountNumber          String   @default("03000000000")
  bankName               String?  @default("")
  branchCode             String?  @default("")
  businessName           String   @default("Devbase / QSalon")
  defaultCommissionRateBps Int     @default(1000) // 1000 = 10% of advance (5% of full booking)
  updatedBy              String   @default("System")
  updatedAt              DateTime @default(now()) @updatedAt
}

model AppointmentService {
  appointmentId String
  serviceId     String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([appointmentId, serviceId])
}

model Review {
  id               String       @id @default(cuid())
  salonId          String
  appointmentId    String?      @unique
  customerName     String
  customerPhone    String
  rating           Int
  comment          String       @default("")
  likedTagsJson    String       @default("[]")
  dislikedTagsJson String       @default("[]")
  platformFeedback String       @default("")
  createdAt        DateTime     @default(now())
  salon            Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointment      Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([salonId])
}
